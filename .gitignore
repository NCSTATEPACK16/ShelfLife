node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# Generated art (ADR 0006). Frames and placeholders are intermediates, regenerable from
# text sources by `npm run art:build`, so they stay out of the history.
assets/src/
assets/placeholder/

# assets/atlases/ is deliberately NOT ignored. Netlify runs `vite build` and nothing else
# — no Python, no Pillow, no Blender — so the packed atlases are a committed build input.
# They are small (16-bit art), which is also why this project needs no Git LFS.

# native
ios/App/Pods/
ios/App/build/
*.xcuserstate
DerivedData/

# Local-only planning docs — deliberately untracked so they stay off the public repo.
# The build does not read them; they are the human/agent working record.
PLAN.md
docs/handoff.md
**/handoff*.md

# env & local
.env
.env.*
!.env.example
.DS_Store
.netlify/
test-results/
playwright-report/
.claude/settings.local.json

# Python bytecode from the art pipeline
__pycache__/
*.pyc
