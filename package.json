{
  "name": "shelf-life",
  "version": "0.1.0",
  "private": true,
  "description": "An isometric supermarket tycoon. Web first, iOS via Capacitor.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build": "npm run build:landing && npm run build:game",
    "build:game": "vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run check:tokens && npm run check:content && npm run test && npm run build",
    "cap:sync": "npm run build:game && cap sync ios",
    "cap:open": "cap open ios",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:content": "node tools/check-gentle-surface.mjs",
    "check:budget": "node tools/check-budget.mjs",
    "harness:build": "vite build --config vite.harness.config.ts",
    "harness": "npm run harness:build --silent && node dist/harness/cli.js"
  },
  "dependencies": {
    "@preact/signals": "2.4.0",
    "bitecs": "0.4.0",
    "idb-keyval": "6.3.0",
    "json5": "^2.2.3",
    "mitt": "3.0.1",
    "phaser": "4.2.1",
    "preact": "10.29.7",
    "pure-rand": "8.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
