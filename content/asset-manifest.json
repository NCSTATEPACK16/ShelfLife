    { "id": "wall_back",       "route": "procedural", "atlas": "world", "size": [32, 48], "anchor": [0.5, 1], "layer": "fixture" },
    { "id": "wall_side",       "route": "procedural", "atlas": "world", "size": [32, 48], "anchor": [0.5, 1], "layer": "fixture" },

    { "id": "shelf_basic",     "route": "procedural", "atlas": "world", "size": [32, 48], "anchor": [0.5, 1], "layer": "fixture", "footprint": [1, 2], "states": ["full", "half", "empty"], "rotations": 2 },
    { "id": "shelf_endcap",    "route": "procedural", "atlas": "world", "size": [32, 40], "anchor": [0.5, 1], "layer": "fixture", "footprint": [1, 1], "states": ["full", "half", "empty"], "rotations": 2 },
