{
  "$meta": {
    "name": "Shelf Life asset manifest",
    "version": "0.1.0",
    "note": "Every visual is declared here BEFORE it exists (ADR 0006). Missing art renders as a labelled placeholder at the exact declared size, so the game is playable at every commit and renderer work never blocks on art work.",
    "tileSize": 32,
    "projection": "orthogonal-3/4 (ADR 0004)",
    "frameKey": "<id> | <id>__<state> | <id>__r<rotation> | <id>__<state>__r<rotation> | ...__f<frame> | ...__p<palette>"
  },

  "palettes": {
    "$comment": "Palette-swap variants (ADR 0006). Each maps sprite characters to palette names from tools/art/palette.py. One shopper base x seven segments = seven shoppers for the cost of one. Segment ids match content/balance/segments.json5.",
    "priceHunter": { "h": "hair-sh", "H": "hair", "r": "amber-dark", "R": "amber-base" },
    "convenience": { "h": "hair", "H": "hair-hi", "r": "blue-base", "R": "blue-light" },
    "family":      { "h": "hair-sh", "H": "hair", "r": "green-base", "R": "green-light" },
    "foodie":      { "h": "ink", "H": "hair-sh", "r": "violet-base", "R": "violet-light" },
    "bulk":        { "h": "hair-hi", "H": "skin-hi", "r": "red-dark", "R": "red-base" },
    "senior":      { "h": "grey-200", "H": "grey-50", "r": "grey-400", "R": "grey-300" },
    "student":     { "h": "ink", "H": "hair", "r": "red-base", "R": "red-light" }
  },

  "assets": [
