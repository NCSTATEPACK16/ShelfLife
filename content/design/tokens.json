{
  "$schema": "./tokens.schema.json",
  "$meta": {
    "name": "Shelf Life Design Tokens",
    "version": "0.1.0",
    "source": "authored in code; Figma variables mirror this file (PLAN.md §11.6)",
    "note": "Single source of truth for the game UI (src/ui) and the landing page. A hardcoded hex anywhere in either fails CI."
  },

  "color": {
    "$comment": "Two families. `fixture` is the desaturated warm-grey ramp the store world is built from (PLAN.md §9.3) and the UI borrows for chrome. `product` is the saturated family reserved for goods, data, and state — never for chrome.",

    "fixture": {
      "50":  "#F4F3F0",
      "100": "#E8E6E1",
      "200": "#D6D3CB",
      "300": "#B4B0A6",
      "400": "#8A867C",
      "500": "#615E56",
      "600": "#403E38",
      "700": "#2A2926",
      "800": "#1E1D1A",
      "900": "#141311"
    },

    "product": {
      "red":    { "base": "#E23D2E", "light": "#F05243", "dark": "#B32C20", "$use": "price tags, markdowns, the primary accent" },
      "green":  { "base": "#1F7A4D", "light": "#2FA268", "dark": "#155838", "$use": "fresh/produce, positive deltas" },
      "amber":  { "base": "#D9931B", "light": "#F0AE38", "dark": "#A66E10", "$use": "spoilage warning, markdown-eligible" },
      "blue":   { "base": "#2C6BA8", "light": "#3E87CC", "dark": "#1E4D7A", "$use": "dairy/frozen, informational" },
      "violet": { "base": "#6B4A9E", "light": "#8763C2", "dark": "#4E3475", "$use": "rival identity default, loyalty" }
    },

    "semantic": {
      "$comment": "Semantic state is separate from brand accent. Never overload the accent to mean 'good'.",
      "good":     "#1F7A4D",
      "warning":  "#D9931B",
      "critical": "#E23D2E",
      "neutral":  "#615E56",
      "spoiled":  "#7A5C2E"
    },

    "theme": {
      "light": {
        "ground":       "#E8E6E1",
        "surface":      "#F4F3F0",
        "surfaceRaised":"#FFFFFF",
        "ink":          "#1A1917",
        "inkMuted":     "#615E56",
        "inkFaint":     "#8A867C",
        "line":         "#D6D3CB",
        "lineStrong":   "#B4B0A6",
        "accent":       "#E23D2E",
        "accentInk":    "#FFFFFF"
      },
      "dark": {
        "ground":       "#141311",
        "surface":      "#1E1D1A",
        "surfaceRaised":"#2A2926",
        "ink":          "#F0EEE9",
        "inkMuted":     "#A8A49A",
        "inkFaint":     "#78746B",
        "line":         "#33312C",
        "lineStrong":   "#4A473F",
        "accent":       "#F05243",
        "accentInk":    "#141311"
      }
    }
  },

  "type": {
    "$comment": "Three roles. Signage is heavy and tight — supermarket wayfinding. Body is neutral. Register is monospaced and carries every number, because prices and receipts are monospaced in the real world.",
    "family": {
      "signage":  "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "body":     "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "register": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
    },
    "scale": {
      "$comment": "1.25 minor third. Values in rem.",
      "xs":   "0.75",
      "sm":   "0.875",
      "base": "1",
      "md":   "1.125",
      "lg":   "1.375",
      "xl":   "1.75",
      "2xl":  "2.25",
      "3xl":  "3"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 },
    "tracking": {
      "signage": "-0.02em",
      "body":    "0",
      "label":   "0.08em"
    },
    "leading": { "tight": 1.1, "snug": 1.3, "normal": 1.55 }
  },

  "space": {
    "$comment": "4px base. Use gap, not margins (CLAUDE.md).",
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px"
  },

  "radius": {
    "$comment": "Restrained. Fixtures are metal shelving, not pills.",
    "none": "0", "sm": "2px", "md": "4px", "lg": "8px", "tag": "3px", "full": "999px"
  },

  "elevation": {
    "flat":   "none",
    "raised": "0 1px 2px rgba(20,19,17,0.10), 0 2px 6px rgba(20,19,17,0.06)",
    "panel":  "0 2px 4px rgba(20,19,17,0.12), 0 8px 24px rgba(20,19,17,0.10)",
    "sheet":  "0 -2px 16px rgba(20,19,17,0.18)"
  },

  "layout": {
    "$comment": "PLAN.md §7.2 — two breakpoints, and only two.",
    "breakpoint": { "compact": "0px", "regular": "768px" },
    "hitTarget":  { "min": "44px", "$note": "iOS HIG minimum. Applies to every interactive element, at both breakpoints." },
    "safeArea": {
      "top":    "var(--safe-area-inset-top, env(safe-area-inset-top, 0px))",
      "bottom": "var(--safe-area-inset-bottom, env(safe-area-inset-bottom, 0px))",
      "left":   "var(--safe-area-inset-left, env(safe-area-inset-left, 0px))",
      "right":  "var(--safe-area-inset-right, env(safe-area-inset-right, 0px))"
    },
    "homeIndicatorGuard": "34px",
    "maxReadWidth": "65ch"
  },

  "motion": {
    "$comment": "Sparing. The world animates; the UI mostly doesn't.",
    "duration": { "instant": "80ms", "fast": "140ms", "base": "220ms", "slow": "380ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter":    "cubic-bezier(0, 0, 0, 1)",
      "exit":     "cubic-bezier(0.3, 0, 1, 1)"
    },
    "$reducedMotion": "All durations collapse to 0ms under prefers-reduced-motion."
  },

  "chart": {
    "$comment": "Categorical series draw from `product`, in this order, so category color is stable across every chart in the game.",
    "categorical": ["#2C6BA8", "#1F7A4D", "#D9931B", "#E23D2E", "#6B4A9E", "#8A867C"],
    "benchmarkLine": "#8A867C",
    "gridLine": "#D6D3CB",
    "$rule": "Every KPI renders against a benchmark (PLAN.md §12.4). The benchmark is always the neutral grey, never a series color."
  }
}
