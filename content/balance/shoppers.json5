{
  // Satisfaction formula weights (PLAN.md §5.3). fillRate, discovery, spoiledEncounters
  // (1.7), and — as of phase 1.8's CheckoutSystem — queuePenalty are all live now.
  // staffInteraction/cleanliness-as-a-satisfaction-term still aren't wired to a shopper
  // outcome (cleanliness itself exists as a CheckoutSystem value, just not consumed here
  // yet) and remain 0.
  fillRateWeight: 0.6,
  discoveryWeight: 0.1,
  spoiledEncountersWeight: 0.2,
  queuePenaltyWeight: 0.3,
  // Extra flat penalty when a wait ends in cart abandonment rather than a balk — both
  // saturate queuePenalty to its max, so this is what keeps abandonment scoring worse.
  abandonExtraPenalty: 0.15,

  // Radius (in grid cells) within which a shopper's walked path exposes a stocked good to
  // an impulse roll — PLAN.md §5.4's "path exposure," computed from actually-walked tiles.
  exposureRadius: 2,

  // A shopper counts as "arrived" at a non-walkable destination (a shelf or register —
  // you can't stand inside a fixture) when within this many cells of it.
  adjacentCellThreshold: 1,
}
