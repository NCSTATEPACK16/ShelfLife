  {
    segment: 'priceHunter',
    weights: {
      priceFit: 0.9, assortmentFit: 0.2, quality: 0.1, service: 0.1,
      ambiance: 0.1, loyalty: 0.2, brandAffinity: 0.1, travelCost: 0.4,
